# Anthropic API key for live and record runs; leave empty for replay.
ANTHROPIC_API_KEY=
# Model id used by the model skills.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Jev key; leave empty to run with Claude alone.
TYPESAFE_API_KEY=
# Run mode: live, replay or record.
RUN_MODE=live
# Seed for the lead queue the morning run posts.
SEED=42
# Set true to switch on Stand's answer key in the leadgen container.
DEBUG=false
