# ABOUTME: The seven variables the app and compose read from .env, each with its default; copy it to .env and fill in the key.
# ABOUTME: .env itself is untracked and is never committed; compose passes it to the app as its env_file.
# DeepSeek API key for live and record runs; leave empty for replay.
MODEL_API_KEY=
# Anthropic-format endpoint the model skills call.
MODEL_BASE_URL=https://api.deepseek.com/anthropic
# Model id used by the model skills.
MODEL_ID=deepseek-flash
# Jev key; leave empty to run on the language model alone.
TYPESAFE_API_KEY=
# Run mode: live, replay or record.
RUN_MODE=live
# Seed for the lead queue the morning run posts.
SEED=42
# Set true to switch on Stand's answer key in the leadgen container.
DEBUG=false
