{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format-on-edit.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.sh", "timeout": 300 }]
      }
    ]
  },
  "permissions": {
    "deny": ["Edit(sim-harness/**)", "Write(sim-harness/**)", "Edit(docs/brief/**)", "Write(docs/brief/**)", "Edit(docs/playbook/**)", "Write(docs/playbook/**)", "Read(.env)"]
  }
}
