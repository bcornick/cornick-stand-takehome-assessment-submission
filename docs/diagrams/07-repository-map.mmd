flowchart LR
    ROOT["repo root"]

    subgraph TOP["Top level"]
        direction TB
        WEB["web/<br/>React UI"]
        EV["evals/<br/>runner, graders, controls,<br/>labels, results.jsonl"]
        RECD["recordings/<br/>model and Jev exchanges"]
        FX["fixtures/replies/<br/>producer replies, held/ kept back"]
